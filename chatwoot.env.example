# Copiar a .env.chatwoot y completar. Nunca commitear .env.chatwoot (lo ignora ".env.*").
# Usado por compose.chatwoot.yml.

# Generar con: docker run --rm chatwoot/chatwoot:v4.18.0 bundle exec rake secret
SECRET_KEY_BASE=reemplazar_con_hex_largo_generado

# Contraseña de la base de Chatwoot (servicio postgres de compose.chatwoot.yml)
POSTGRES_PASSWORD=reemplazar_con_password_propia

# Contraseña de Redis (servicio redis de compose.chatwoot.yml)
REDIS_PASSWORD=reemplazar_con_password_propia
