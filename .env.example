# Copiar a .env y completar. Nunca commitear .env.
# Chatwoot (CP1)
# Con uvicorn en el host: localhost. Con la imagen (compose.yml): http://host.docker.internal:3030
CHATWOOT_URL=http://localhost:3030
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_BOT_TOKEN=
# Secret del Agent Bot en Chatwoot: firma cada evento (X-Chatwoot-Signature, R49). La URL del bot va sin ?token=
CHATWOOT_WEBHOOK_SECRET=
# Solo en local, para la tarea 1.6: guarda los payloads crudos en capturas/ (vacío = apagado)
CHATWOOT_CAPTURAR_PAYLOADS=
# Claude API (CP2): la lee agente.py recién en la primera llamada (R53)
ANTHROPIC_API_KEY=
# Base SQLite de la memoria (R27). Vacío = memoria.db en la raíz del repo; en Docker, un volumen
# MEMORIA_RUTA=
# Un solo worker (R28): con WEB_CONCURRENCY o --workers mayor a 1, el bot no arranca
